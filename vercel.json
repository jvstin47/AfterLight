{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/globe",
      "destination": "/globe.html"
    },
    {
      "source": "/design-lab",
      "destination": "/design-lab/index.html"
    },
    {
      "source": "/fernhollow",
      "destination": "/fernhollow.html"
    },
    {
      "source": "/tidewell",
      "destination": "/tidewell.html"
    },
    {
      "source": "/((?!assets/|globe|design-lab|fernhollow|tidewell).*)",
      "destination": "/index.html"
    }
  ]
}
