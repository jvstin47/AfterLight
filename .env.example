# AFTERLIGHT — Environment Configuration
# All client-accessible variables must be prefixed with VITE_

# Application Metadata
VITE_APP_TITLE=AFTERLIGHT — The Living Archival Monument
VITE_APP_STATION=STATIO COGNITUM
VITE_APP_LATITUDE=-3.01239
VITE_APP_LONGITUDE=-23.42157

# Astronomical Constants
VITE_LUNAR_RADIUS_KM=1737.4

# API Configuration
VITE_API_BASE_URL=/api
VITE_API_TIMEOUT_MS=8000

# Feature Toggles
VITE_AUDIO_DEFAULT_MUTED=true
VITE_ENABLE_VIDICON_SCAN=true
VITE_ENABLE_ANALYTICS=false
VITE_DEBUG_MODE=false
